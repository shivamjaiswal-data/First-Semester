def clean_customer(raw):

    # Split the record

    fields = raw.split(';')

    if len(fields) != 4:
        return None

    name = fields[0].strip()
    email = fields[1].strip()
    phone = fields[2].strip()
    city = fields[3].strip()


    # A. Name and City Validation

    name = name.title()
    city = city.title()

    if city == '':
        return None

    for word in name.split():

        if not word.isalpha():
            return None


    # B. Email Validation

    email = email.lower()

    if email.count('@') != 1:
        return None

    username, domain = email.split('@')

    if username == '':
        return None

    if '.' not in domain:
        return None

    if domain[0] == '.' or domain[-1] == '.':
        return None


    # C. Phone Validation

    phone = phone.replace(' ', '')
    phone = phone.replace('-', '')

    if phone.startswith('+91'):
        phone = phone[3:]

    elif len(phone) == 12 and phone.startswith('91'):
        phone = phone[2:]

    if len(phone) != 10:
        return None

    if not phone.isdigit():
        return None

    if phone[0] not in '6789':
        return None


    # Return Valid Customer Dictionary

    return {
        'name': name,
        'email': email,
        'phone': phone,
        'city': city
    }


# Process All Customer Records

rejected = 0

for raw in lines:

    result = clean_customer(raw)

    if result is not None:
        print(result)

    else:
        rejected = rejected + 1


